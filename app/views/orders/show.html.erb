
<div class="container py-5">
  <div class="alert alert-success">
    <h2>Thank You for Your Order!</h2>
    <p>Your order has been placed successfully.</p>
  </div>

  <h3>Omart Modest Wear — Order Invoice</h3>

  <p><strong>Order Number:</strong> #<%= @order.id %></p>
  <p><strong>Order Date:</strong> <%= @order.created_at.strftime("%B %d, %Y") %></p>
  <p><strong>Status:</strong> <%= @order.status.titleize %></p>

  <hr>

  <h4>Customer Information</h4>
  <p>
    <strong>Name:</strong> <%= @order.full_name %><br>
    <strong>Email:</strong> <%= @order.email %>
  </p>

  <h4>Shipping Address</h4>
  <p>
    <%= @order.street_address %><br>
    <%= @order.city %>, <%= @order.province %><br>
    <%= @order.postal_code %>
  </p>

  <hr>

  <h4>Purchased Products</h4>

  <table class="table table-bordered">
    <thead>
      <tr>
        <th>Product</th>
        <th>Unit Price</th>
        <th>Quantity</th>
        <th>Subtotal</th>
      </tr>
    </thead>

    <tbody>
      <% @order.order_items.each do |item| %>
        <tr>
          <td><%= item.product.name %></td>
          <td><%= number_to_currency(item.unit_price) %></td>
          <td><%= item.quantity %></td>
          <td>
            <%= number_to_currency(item.unit_price * item.quantity) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="text-end">
    <p><strong>Subtotal:</strong> <%= number_to_currency(@order.subtotal) %></p>
    <p><strong>Sales Tax:</strong> <%= number_to_currency(@order.tax) %></p>
    <h4><strong>Total:</strong> <%= number_to_currency(@order.total) %></h4>
  </div>

  <hr>

  <%= link_to "Continue Shopping", root_path, class: "btn btn-dark" %>
</div>
